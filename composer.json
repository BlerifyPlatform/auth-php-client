{
  "name": "blerify/auth-php-client",
  "description": "Blerify service-account authentication for PHP: signs a JWT client assertion and exchanges it at the Blerify IAM token endpoint for an access token (RFC 7523 private_key_jwt).",
  "type": "library",
  "license": "MIT",
  "keywords": ["blerify", "authentication", "jwt", "oauth2", "service-account"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.0",
    "ramsey/uuid": "^4.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Blerify\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Blerify\\Auth\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
